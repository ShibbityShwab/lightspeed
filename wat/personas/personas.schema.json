{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LightSpeed persona roster",
  "type": "object",
  "required": ["version", "personas"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "lead": {
      "type": "object",
      "required": ["slug", "display"],
      "properties": {
        "slug": { "type": "string", "const": "lead" },
        "display": { "type": "string" },
        "owns": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "display", "file", "owns", "when_to_use"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$" },
          "display": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.md$" },
          "owns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "when_to_use": { "type": "string", "minLength": 10 },
          "pairs_with": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "task_conventions": {
      "type": "object",
      "required": ["subject", "owner", "write_scopes", "evidence"],
      "properties": {
        "subject": { "type": "string" },
        "owner": { "type": "string" },
        "write_scopes": { "type": "string" },
        "evidence": { "type": "string" },
        "dependencies": { "type": "string" },
        "naming": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
